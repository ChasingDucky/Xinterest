# Docker Environment Variables
# Copy this file to .env for docker-compose

# JWT Secret Key (IMPORTANT: Change this in production!)
JWT_SECRET=xinterest-secret-key-change-in-production

# Optional: MongoDB credentials (if using authenticated MongoDB)
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=password

# Application Settings
NODE_ENV=production
